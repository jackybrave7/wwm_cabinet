Options -Indexes +FollowSymLinks
RewriteEngine On

# Static assets
RewriteRule ^assets/ - [L]

# Front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

# Block direct HTTP access to private folders (if misplaced under docroot)
RewriteRule ^(app|config|data|scripts|templates)/ - [F,L]

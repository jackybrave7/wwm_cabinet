      "skip_if_demo_active": true,
      "label": "Grant demo (skip if already active or paid)"
    },
    "gate_paid_1": {
      "type": "condition",
      "condition": "has_paid_any",
      "label": "Purchased already?"
    },
    "end_paid": {
      "type": "end",
      "outcome": "converted",
      "label": "End (purchased)"
    },
    "wait_view": {
      "type": "wait_event",
      "condition": "demo_lesson_opened",
      "course_slug": "elke-en",
      "timeout_seconds": 72000,
      "then_delay_seconds": 5400,
      "poll_seconds": 900,
      "label": "Wait until the lesson is opened (then 90 min), or 20 hours"
    },
    "mail_not_opened": {
      "type": "send_template",
      "template": "reminder_demo_no_login",
      "course_slug": "elke-en",
      "skip_if_paid_course": true,
      "stale_after_seconds": 604800,
      "label": "Reminder — lesson not opened (20h)"
    },
    "wait_view_rest": {
      "type": "wait_event",
